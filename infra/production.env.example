# Used by: docker compose --env-file .env -f infra/compose.yaml up -d
# Replace all placeholder values. Do not commit the resulting .env file.
JP_IMAGE=ghcr.io/replace-owner/replace-repository:latest
SITE_ADDRESS=poker.example.com
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-url-safe-base64-secret-at-least-32-bytes
# URL-encode reserved characters in the PostgreSQL username and password.
DATABASE_URL=postgresql+asyncpg://jpoker:replace-with-a-long-random-password@postgres.example.internal:5432/jpoker
LOG_LEVEL=INFO
RATE_LIMIT_CREATE_PER_MINUTE=20
RATE_LIMIT_JOIN_PER_MINUTE=60
RATE_LIMIT_TICKET_PER_MINUTE=120

# Redis is deliberately absent. The current single-container architecture does
# not read REDIS_URL; enabling it requires the multi-instance implementation.
